{
  "name": "@vicinage/unplugin",
  "version": "0.18.42",
  "description": "Universal bundler plugin for Vicinage",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chbybnwr/vicinage-unplugin.git"
  },
  "homepage": "https://github.com/chbybnwr/vicinage-unplugin",
  "bugs": {
    "url": "https://github.com/chbybnwr/vicinage-unplugin/issues"
  },
  "funding": "https://github.com/sponsors/chbybnwr",
  "keywords": [
    "bundler",
    "css",
    "inline",
    "jsx",
    "plugin",
    "stylex",
    "unplugin",
    "vite",
    "vicinage"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./*": {
      "import": "./dist/adapters/*.js",
      "require": "./dist/adapters/*.cjs"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#/*": "./dist/*"
  },
  "scripts": {
    "prepack": "pn run build && npm pkg delete scripts packageManager devDependencies",
    "check": "pn run typecheck && pn run test --coverage && pn run lint && pn run format --check && pn run spellcheck",
    "build": "tsdown",
    "compile": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --build",
    "test": "vitest run --silent=passed-only",
    "lint": "eslint ./",
    "format": "prettier ./",
    "spellcheck": "cspell ./"
  },
  "engines": {
    "runtime": {
      "name": "node",
      "version": "^24 || ^25 || ^26",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.2.1",
  "dependencies": {
    "@babel/core": "^8.0.1",
    "@babel/helper-plugin-utils": "^8.0.1",
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4",
    "@stylexjs/babel-plugin": "~0.19.0",
    "@stylexjs/unplugin": "~0.19.0",
    "@typescript/typescript6": "^6.0.2",
    "magic-string": "^1.2.3",
    "picomatch": "^4.0.7",
    "unplugin": "^3.3.0"
  },
  "devDependencies": {
    "@chbybnwr/tsconfig": "github:chbybnwr/tsconfig",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@eslint/markdown": "^8.0.3",
    "@farmfe/core": "^1.7.11",
    "@nuxt/kit": "^4.5.2",
    "@nuxt/schema": "^4.5.2",
    "@stylexjs/stylex": "~0.19.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@txe/eslint-plugin-x": "~0.2.1",
    "@types/node": "^26.4.1",
    "@types/picomatch": "^4.0.3",
    "@typescript-eslint/parser": "^8.69.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "cspell": "^10.2.0",
    "csstype": "^3.2.3",
    "esbuild": "~0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "solarwindcss": "file:modules/solarwindcss-0.37.10.tgz",
    "styledeck": "file:modules/styledeck-0.8.22.tgz",
    "tsdown": "~0.22.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue": "^3.5.42",
    "webpack": "^5.110.3"
  }
}
