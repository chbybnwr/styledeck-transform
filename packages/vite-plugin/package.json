{
  "name": "@styledeck/vite-plugin",
  "version": "0.1.0",
  "description": "Vite plugin for StyleDeck",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chbybnwr/styledeck-transform.git"
  },
  "homepage": "https://github.com/chbybnwr/styledeck-transform/packages/vite-plugin",
  "bugs": {
    "url": "https://github.com/chbybnwr/styledeck-transform/issues"
  },
  "funding": "https://github.com/sponsors/chbybnwr",
  "keywords": [
    "styledeck",
    "vite",
    "plugin",
    "css",
    "jsx",
    "stylex"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepack": "pn run build && pn pkg delete scripts packageManager devDependencies && node --experimental-strip-types ../../scripts/prepack.ts",
    "check": "pn run type-check && pn run test --coverage && pn run lint && pn run format --check && pn run spell-check",
    "build": "tsdown",
    "extract": "tsc --project tsconfig.build.json && api-extractor run",
    "type-check": "tsc --build",
    "test": "vitest run --silent=passed-only",
    "lint": "eslint ./",
    "format": "prettier ./",
    "spell-check": "cspell ./"
  },
  "engines": {
    "runtime": {
      "name": "node",
      "version": "^24 || ^25 || ^26",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@styledeck/transform": "workspace:*",
    "@stylexjs/unplugin": "~0.19.0"
  },
  "peerDependencies": {
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@chbybnwr/tsconfig": "github:chbybnwr/tsconfig",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@eslint/markdown": "^8.0.3",
    "@microsoft/api-extractor": "^7.59.0",
    "@stylexjs/stylex": "~0.19.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@txe/eslint-plugin-x": "~0.2.1",
    "@types/node": "^26.4.1",
    "@types/picomatch": "^4.0.3",
    "@typescript-eslint/parser": "^8.69.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "cspell": "^10.2.2",
    "csstype": "^3.2.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsdown": "~0.23.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
